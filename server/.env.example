# Connexia sync server configuration.
#
# The server reads these from the process environment (Coolify: resource ->
# Environment Variables). This file is documentation only - it is NOT
# loaded automatically and is safe to commit (contains no secrets).

# Listen port (default: 8047)
PORT=8047

# Where the SQLite fallback database lives (default: ./data)
DATA_DIR=/data

# ---- Storage ----------------------------------------------------------
# Optional PostgreSQL connection string. Set this to use Postgres (works
# with Coolify's PgBouncer URL too). When unset, a pure-Go SQLite database
# is used automatically in DATA_DIR. Legacy JSON data is migrated on boot.
# Example: postgres://user:pass@host:5432/syncserver
DATABASE_URL=

# ---- Web dashboard / admin --------------------------------------------
# Server name shown on the public landing page.
SERVER_NAME="Connexia Sync Server"

# /admin is protected by the admin account: the first account registered on
# a fresh server (or the registration form on /admin itself) becomes admin.
# No separate admin token is needed.

# ---- Email verification (SMTP) ----------------------------------------
# Without SMTP_HOST, verification codes are printed to the server log only.
# Use your own relay or a transactional provider (Brevo, Mailgun, Postmark).

# SMTP relay host, e.g. smtp.brevo.com or smtp.gmail.com
SMTP_HOST=

# SMTP port (default: 587, or 465 when SMTP_SECURE=true)
SMTP_PORT=587

# true = implicit TLS on port 465; false = STARTTLS on 587
SMTP_SECURE=false

# AUTH PLAIN credentials. For Gmail use an app password, not your password.
SMTP_USER=
SMTP_PASS=

# Sender shown on verification emails
SMTP_FROM="Connexia <noreply@sync.connexia.run>"
