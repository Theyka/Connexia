<?xml version="1.0" encoding="utf-8"?>
<!-- Brand launcher icon: dark square with a teal terminal prompt.
     API 26+ uses this adaptive icon (color background + transparent
     foreground PNGs); older APIs fall back to the legacy
     mipmap-*/ic_launcher.png bitmaps. The monochrome layer reuses the
     foreground for Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
